<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="tigo" xmlns:ignition="http://ignitionrobotics.org/schema">
    <pose>4.2 2.5 0.041 0 0 -1.5708</pose>

    <!-- ========================================== -->
    <!-- CHASSI (CORPO PRINCIPAL)                   -->
    <!-- ========================================== -->
    <link name="base_link">
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.017</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.022</iyy><iyz>0</iyz>
          <izz>0.034</izz>
        </inertia>
      </inertial>

      <!-- COLISÃO FÍSICA SIMPLIFICADA (EVITA TRAVAMENTO NO PISO E PERMITE COLIDIR COM OBSTÁCULOS) -->
      <!-- O box fica elevado (z=0.06 com altura 0.08, indo de z=0.02 a z=0.10) para não arrastar no chão -->
      <collision name="chassis_collision">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <box><size>0.26 0.22 0.08</size></box>
        </geometry>
      </collision>

      <!-- STL APENAS VISUAL (NUNCA EM COLLISION PARA NÃO PESAR OU TRAVAR A FÍSICA) -->
      <visual name="chassis_visual">
        <pose>0 0 0.069 0 0 -1.5708</pose>
        <geometry>
          <mesh>
            <uri>../models/meshes/Tigo_para_gazebo.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>

      <!-- CÂMERA DE PROFUNDIDADE VIRTUAL (valores do datasheet; alcance de profundidade 0.10-10 m é SUPOSIÇÃO) -->
      <sensor name="ascamera_hp60c" type="depth_camera">
        <!-- Posição tirada do modelo 3D (oval da câmera): lente na face da frente, 16,5 cm à frente da origem do modelo, centrada; 9,2 cm do piso (base_link fica a 4,1 cm do piso) -->
        <pose>0.165 0 0.049 0 0 0</pose>
        <update_rate>30</update_rate>
        <always_on>true</always_on>
        <topic>/ascamera_hp60c/camera_publisher/depth0/image_raw</topic>
        <ignition_frame_id>camera_optical_link</ignition_frame_id>
        <camera>
          <horizontal_fov>1.396</horizontal_fov> <!-- 80 graus (datasheet: FOV H 80, V 43, D 90) -->
          <image>
            <!-- Real: 1920x1080 por lente, 30 fps. Na simulação usamos 640x360 (mesma proporção 16:9) para não pesar -->
            <width>640</width>
            <height>360</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.10</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>

      <!-- CÂMERA RGB VIRTUAL (lente esquerda do módulo estéreo). Mesma posição e campo de visão da profundidade. -->
      <!-- SUPOSIÇÃO: tópico rgb0 (o nome real do driver pode ser outro) e 15 fps para não pesar a simulação -->
      <sensor name="ascamera_hp60c_rgb" type="camera">
        <pose>0.165 0 0.049 0 0 0</pose>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <topic>/ascamera_hp60c/camera_publisher/rgb0/image_raw</topic>
        <ignition_frame_id>camera_optical_link</ignition_frame_id>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.10</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>

      <!-- LIDAR 2D VIRTUAL (publica em /scan, frame laser_link) -->
      <!-- Datasheet: 360 graus, 10 Hz, 12 m, resolução 0.9 graus (400 pontos/volta, 4000 pts/s) -->
      <!-- Posição tirada do modelo 3D (cilindro do lidar): 13,55 cm à frente da origem do modelo, centrado. Topo do cilindro a 17,4 cm do piso. -->
      <!-- O plano de varredura (16,4 cm do piso) é SUPOSIÇÃO: 2,5 cm acima do fundo do lidar medido no robô real (13,89 cm). -->
      <!-- SUPOSIÇÕES: plano de varredura 2,5 cm acima do fundo (z = 0,1389 + 0,025 - 0,041 = 0,123), alcance mínimo 0.12 m, ruído 0.01 m -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.1355 0 0.123 0 0 0</pose>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/scan</topic>
        <ignition_frame_id>laser_link</ignition_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>400</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <!-- ========================================== -->
    <!-- RODAS MECANUM COM ATRITO DIRECIONAL        -->
    <!-- ========================================== -->

    <!-- RODA DIANTEIRA ESQUERDA (FL) -->
    <link name="front_left_wheel">
      <pose>0.082 0.106 0 -1.5707 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.041</radius></sphere></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 ignition:expressed_in="base_link">1 -1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.041</radius></sphere></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- RODA DIANTEIRA DIREITA (FR) -->
    <link name="front_right_wheel">
      <pose>0.082 -0.106 0 -1.5707 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.041</radius></sphere></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 ignition:expressed_in="base_link">1 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.041</radius></sphere></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- RODA TRASEIRA ESQUERDA (RL) -->
    <link name="rear_left_wheel">
      <pose>-0.082 0.106 0 -1.5707 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.041</radius></sphere></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 ignition:expressed_in="base_link">1 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.041</radius></sphere></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- RODA TRASEIRA DIREITA (RR) -->
    <link name="rear_right_wheel">
      <pose>-0.082 -0.106 0 -1.5707 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.041</radius></sphere></geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 ignition:expressed_in="base_link">1 -1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.041</radius></sphere></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ========================================== -->
    <!-- JUNTAS DE ROTAÇÃO DAS RODAS                -->
    <!-- ========================================== -->
    <joint name="fl_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="fr_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="rl_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <joint name="rr_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
        </limit>
      </axis>
    </joint>

    <!-- ========================================== -->
    <!-- PLUGIN MECANUM DRIVE                       -->
    <!-- ========================================== -->
    <plugin filename="ignition-gazebo-mecanum-drive-system" name="ignition::gazebo::systems::MecanumDrive">
      <front_left_joint>fl_joint</front_left_joint>
      <front_right_joint>fr_joint</front_right_joint>
      <back_left_joint>rl_joint</back_left_joint>
      <back_right_joint>rr_joint</back_right_joint>
      <wheel_separation>0.212</wheel_separation>
      <wheelbase>0.164</wheelbase>
      <wheel_radius>0.041</wheel_radius>
      <min_acceleration>-5</min_acceleration>
      <max_acceleration>5</max_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/model/tigo/odometry</odom_topic>
      <tf_topic>/model/tigo/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
